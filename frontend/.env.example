# ==============================================
# Sinergiya Frontend Environment Variables
# ==============================================

# API Configuration
NEXT_PUBLIC_API_URL=https://sinergiya-backend-xxxx.vercel.app/api

# App Configuration
NEXT_PUBLIC_APP_NAME=Sinergiya
NEXT_PUBLIC_APP_DESCRIPTION=O'zbekiston yoshlari uchun karyera platformasi

# Social Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sinergiya
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sinergiya
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/sinergiya
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/sinergiya
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@sinergiya

# Contact Information
NEXT_PUBLIC_EMAIL=info@sinergiya.uz
NEXT_PUBLIC_PHONE=+998880016777

# Features (true/false)
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_VOICE_MESSAGES=true

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXX

# Development
NEXT_PUBLIC_DEV_MODE=false

