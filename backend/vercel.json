{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PORT": "5000",
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "FRONTEND_URL": "https://step-uz.vercel.app"
  },
  "functions": {
    "src/app.ts": {
      "maxDuration": 30
    }
  }
}
