{
  "version": 2,
  "name": "step-uz-backend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "other",
  "regions": ["iad1"],
  "functions": {
    "src/**/*.ts": {
      "runtime": "nodejs22.x"
    }
  },
  "env": {
    "NODE_VERSION": "22",
    "NODE_ENV": "production",
    "PORT": "10000",
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "JWT_EXPIRES_IN": "7d",
    "FRONTEND_URL": "https://step-uz-frontend.vercel.app",
    "BACKEND_URL": "https://step-uz-backend.vercel.app",
    "REDIS_URL": "@redis_url",
    "SMTP_HOST": "@smtp_host",
    "SMTP_PORT": "@smtp_port",
    "SMTP_USER": "@smtp_user",
    "SMTP_PASS": "@smtp_pass",
    "UPLOAD_DIR": "uploads",
    "MAX_FILE_SIZE": "5MB"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://step-uz-frontend.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
