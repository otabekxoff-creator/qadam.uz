generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StartupStatus {
  PENDING    // Ko'rib chiqilmoqda
  APPROVED   // Tasdiqlangan
  REJECTED   // Rad etilgan
  FUNDED     // Moliyalashtirilgan
}

enum UserRole {
  STUDENT
  COMPANY
  ADMIN
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  INTERVIEW
  OFFERED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  // Email tasdiqlash va kirish kodi uchun maydonlar
  emailVerifiedAt          DateTime?
  verificationCode         String?
  verificationCodeExpiresAt DateTime?
  loginCode                String?
  loginCodeExpiresAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student?
  company   Company?
  notifications Notification[]
  chatsAsParticipant1 Chat[] @relation("ChatParticipant1")
  chatsAsParticipant2 Chat[] @relation("ChatParticipant2")
  sentMessages Message[]

  @@map("users")
}

model Student {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  university   String?
  major        String?
  gpa          Float?
  about        String?       @db.Text
  avatar       String?
  resume       String?
  skills       String[]
  email        String?        // User email dan olish uchun
  applications Application[]
  
  // SHU QATOR QO'SHILDI (Startaplar bilan bog'lanish uchun)
  startups     Startup[]     
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@map("students")
}

model Company {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  industry    String
  website     String?
  location    String
  size        String
  logo        String?
  verified    Boolean  @default(false)
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("companies")
}

model Job {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  description      String        @db.Text
  requirements     String        @db.Text
  responsibilities String?       @db.Text
  location         String
  type             String
  salaryMin        Int?
  salaryMax        Int?
  currency         String        @default("UZS")
  skills           String[]
  status           JobStatus     @default(ACTIVE)
  deadline         DateTime?
  applications     Application[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  @@map("jobs")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coverLetter String?           @db.Text
  resume      String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@unique([jobId, studentId])
  @@map("applications")
}

model Startup {
  id               String        @id @default(uuid())
  title            String
  description      String        @db.Text
  stage            String        @default("IDEA")
  fundingGoal      String?
  teamSize         String?
  website          String?
  pitch            String?       @db.Text
  lookingFor       String?       @db.Text
  timeline         String?       @db.Text
  goalAmount       Float?        // Kerakli sarmoya miqdori (so'mda yoki dollarda)
  status           StartupStatus @default(PENDING)
  logo             String?
  founderName      String
  founderEmail     String
  founderUniversity String?
  
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("startups")
}

model Notification {
  id           String        @id @default(uuid())
  userId       String
  type         String        // JOB_POSTED, APPLICATION_RECEIVED, INTERVIEW_SCHEDULED, etc.
  title        String
  message      String        @db.Text
  isRead       Boolean       @default(false)
  data         Json?         // Additional data (jobId, applicationId, etc.)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Chat {
  id              String        @id @default(uuid())
  participant1Id  String        // First participant (e.g., student)
  participant2Id  String        // Second participant (e.g., company)
  lastMessage     String?       @db.Text
  lastMessageAt   DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  participant1    User          @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2    User          @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages        Message[]

  @@map("chats")
}

model Message {
  id        String        @id @default(uuid())
  chatId    String
  senderId  String
  content   String        @db.Text
  type      MessageType  @default(TEXT)
  isRead    Boolean       @default(false)
  metadata  Json?         // For voice messages (duration, url), images (url, size), etc.
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  chat      Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  FILE
}
