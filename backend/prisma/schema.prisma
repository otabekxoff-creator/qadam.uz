// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// USER ROLES
// =============================================
enum UserRole {
  STUDENT
  COMPANY
  ADMIN
}

// =============================================
// EDUCATION LEVELS
// =============================================
enum EducationLevel {
  HIGH_SCHOOL
  BACHELOR
  MASTER
  PHD
  OTHER
}

// =============================================
// COMPANY SIZES
// =============================================
enum CompanySize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

// =============================================
// JOB TYPES
// =============================================
enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
  REMOTE
  HYBRID
}

// =============================================
// JOB LEVELS
// =============================================
enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  LEAD
  MANAGER
}

// =============================================
// APPLICATION STATUS
// =============================================
enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  HIRED
}

// =============================================
// USER MODEL
// =============================================
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  role           UserRole  @default(STUDENT)
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  emailVerifiedAt DateTime?
  verificationCode String?
  verificationCodeExpiresAt DateTime?
  loginCode String?
  loginCodeExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  student        Student?
  company        Company?
  applications   JobApplication[] @relation("UserApplications")
  savedJobs      SavedJob[] @relation("SavedJobs")

  @@map("users")
}

// =============================================
// STUDENT MODEL
// =============================================
model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  firstName     String
  lastName      String
  birthDate     DateTime
  phone         String?
  university    String?
  major         String?
  gpa           Float?
  bio           String?
  location      String?
  portfolio     String?
  github        String?
  linkedin      String?
  resume        String?
  educationLevel EducationLevel @default(BACHELOR)
  faculty       String?
  graduationYear Int?
  skills        String[]
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   JobApplication[]
  savedJobs      SavedJob[] @relation("SavedJobs")

  @@map("students")
}

// =============================================
// COMPANY MODEL
// =============================================
model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  email        String
  phone        String?
  website     String?
  description String?
  logo        String?
  location    String?
  size        CompanySize @default(SMALL)
  industry    String?
  foundedYear Int?
  employees   Int?
  linkedin    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         Job[]
  applications  JobApplication[] @relation("CompanyApplications")

  @@map("companies")
}

// =============================================
// JOB MODEL
// =============================================
model Job {
  id          String      @id @default(cuid())
  title       String
  description String
  requirements String[]
  responsibilities String[]
  skills      String[]
  salary      String?
  location    String
  type        JobType    @default(FULL_TIME)
  level       JobLevel   @default(ENTRY_LEVEL)
  industry    String?
  experience  String?
  isActive    Boolean     @default(true)
  views       Int         @default(0)
  companyId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedJobs   SavedJob[]

  @@map("jobs")
}

// =============================================
// JOB APPLICATION MODEL
// =============================================
model JobApplication {
  id        String   @id @default(cuid())
  status    ApplicationStatus @default(PENDING)
  coverLetter String?
  resume    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  companyId  String?
  company    Company? @relation("CompanyApplications", fields: [companyId], references: [id])

  userId      String?
  user        User?    @relation("UserApplications", fields: [userId], references: [id])

  @@unique([jobId, studentId])
  @@map("job_applications")
}

// =============================================
// SAVED JOB MODEL
// =============================================
model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Relations
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  studentId  String
  student    Student  @relation("SavedJobs", fields: [studentId], references: [id])

  userId      String?
  user        User?    @relation("SavedJobs", fields: [userId], references: [id])

  @@unique([jobId, studentId])
  @@map("saved_jobs")
}
