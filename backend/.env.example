# ==============================================
# Sinergiya Backend Environment Variables
# ==============================================

# Server Configuration
NODE_ENV=development
# Renderda BACKEND portini 10000 ga qo'yish tavsiya etiladi
PORT=10000

# Database Configuration
# Render PostgreSQL ulanish stringi (production uchun)
# DATABASE_URL="postgresql://username:password@host:port/database"

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_MINIMUM_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_in_production_MINIMUM_64_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# Session Security
SESSION_SECRET=your_session_secret_here_minimum_32_characters
COOKIE_SECRET=your_cookie_secret_here_minimum_32_characters

# Frontend URL (for CORS)
# Lokalda:
# FRONTEND_URL=http://localhost:3000
# Render production:
FRONTEND_URL=https://stepuz-frontend.onrender.com

# Backend public URL (masalan emaildagi linklar uchun)
BACKEND_URL=https://step-uz.onrender.com

# Email yuborish (SMTP) konfiguratsiyasi
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Sinergiya <no-reply@sinergiya.uz>"

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
