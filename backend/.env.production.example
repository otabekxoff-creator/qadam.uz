# ==============================================
# Step.uz Backend Production Environment Variables
# ==============================================

# Server Configuration
NODE_ENV=production
PORT=10000

# Database Configuration (Render)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# JWT Configuration (Generate new secrets for production)
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_MINIMUM_64_CHARACTERS_SECRET_KEY
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_IN_PRODUCTION_MINIMUM_64_CHARACTERS_REFRESH_KEY
JWT_REFRESH_EXPIRES_IN=30d

# Session Security
SESSION_SECRET=CHANGE_THIS_IN_PRODUCTION_MINIMUM_32_CHARACTERS_SESSION_SECRET
COOKIE_SECRET=CHANGE_THIS_IN_PRODUCTION_MINIMUM_32_CHARACTERS_COOKIE_SECRET

# Frontend URL (Render)
FRONTEND_URL=https://YOUR_FRONTEND_URL.onrender.com

# Backend public URL (Render)
BACKEND_URL=https://YOUR_BACKEND_URL.onrender.com

# Email yuborish (SMTP) konfiguratsiyasi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Step.uz <no-reply@step.uz>"

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=warn

# Redis Configuration (Optional)
REDIS_URL=redis://YOUR_REDIS_HOST:6379

# Monitoring (Optional)
SENTRY_DSN=YOUR_SENTRY_DSN

# CORS (Production)
ALLOWED_ORIGINS=https://YOUR_FRONTEND_URL.onrender.com
